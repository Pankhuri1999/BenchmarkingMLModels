"""
GENERAL FAIRNESS IMPROVEMENT MODULE
====================================
A universal fairness improvement system that works across all datasets.

Features:
- Automatic high-disparity detection
- General fairness techniques (not dataset-specific)
- Post-processing calibration
- Feature downweighting based on SHAP analysis
- Model selection based on fairness
- Sample weighting for balanced groups

All techniques are general and work for any dataset.
"""

import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor, RandomForestClassifier
from sklearn.metrics import mean_squared_error, accuracy_score
from scipy.sparse import issparse
import warnings
warnings.filterwarnings('ignore')


def detect_high_disparity_features(shap_importance_dict, feature_names, demographic_groups, 
                                   X_test, y_test, predictions_dict, task_type, 
                                   top_n_features=10, disparity_threshold=0.1):
    """
    Automatically detect features that contribute to high disparity.
    
    Uses SHAP importance to identify top features, then checks if they correlate
    with demographic groups and contribute to disparity.
    
    Args:
        shap_importance_dict: Dict of {model_name: {feature: importance}}
        feature_names: List of feature names
        demographic_groups: Dict of {group_name: boolean_mask}
        X_test: Test features
        y_test: Test targets
        predictions_dict: Dict of {model_name: predictions}
        task_type: 'Regression' or 'Classification'
        top_n_features: Number of top features to check (default: 10)
        disparity_threshold: Threshold for considering feature as high-disparity (default: 0.1)
    
    Returns:
        list: Feature names that contribute to high disparity
    """
    high_disparity_features = []
    
    # Get top features from SHAP (average across models)
    if not shap_importance_dict:
        return []
    
    # Aggregate feature importance across all models
    feature_importance_agg = {}
    for model_name, importance_dict in shap_importance_dict.items():
        if isinstance(importance_dict, dict):
            for feature, importance in importance_dict.items():
                if feature in feature_names:
                    feature_importance_agg[feature] = feature_importance_agg.get(feature, 0) + abs(importance)
    
    # Get top N features
    if not feature_importance_agg:
        return []
    
    sorted_features = sorted(feature_importance_agg.items(), key=lambda x: x[1], reverse=True)
    top_features = [feat for feat, _ in sorted_features[:top_n_features]]
    
    # Check if top features correlate with demographic groups
    # Convert X_test to dense if sparse
    if issparse(X_test):
        X_test_dense = X_test.toarray()
    else:
        X_test_dense = X_test
    
    # Get feature indices
    if isinstance(X_test_dense, pd.DataFrame):
        feature_indices = {name: X_test_dense.columns.get_loc(name) 
                          for name in top_features if name in X_test_dense.columns}
    else:
        # Assume feature_names order matches X_test columns
        feature_indices = {name: idx for idx, name in enumerate(feature_names) 
                          if name in top_features and idx < X_test_dense.shape[1]}
    
    # Check correlation with demographic groups
    for feature_name, feat_idx in feature_indices.items():
        if feat_idx >= X_test_dense.shape[1]:
            continue
        
        feature_values = X_test_dense[:, feat_idx] if len(X_test_dense.shape) > 1 else X_test_dense
        
        # Check if feature values differ significantly between groups
        group_values = {}
        for group_name, group_mask in demographic_groups.items():
            if np.sum(group_mask) > 0:
                group_values[group_name] = feature_values[group_mask]
        
        if len(group_values) >= 2:
            # Calculate mean difference between groups
            group_means = [np.mean(vals) for vals in group_values.values()]
            if len(group_means) >= 2:
                mean_diff = abs(group_means[0] - group_means[1])
                mean_std = np.mean([np.std(vals) for vals in group_values.values()])
                
                # If difference is significant relative to std
                if mean_std > 0 and (mean_diff / mean_std) > disparity_threshold:
                    high_disparity_features.append(feature_name)
    
    return high_disparity_features


def apply_post_processing_calibration(y_pred, y_test, demographic_groups, task_type, 
                                     target_disparity=None):
    """
    Apply post-processing calibration to reduce disparity.
    
    General technique: Adjust predictions to equalize group performance.
    Works for both regression and classification.
    
    Args:
        y_pred: Original predictions
        y_test: True values
        demographic_groups: Dict of {group_name: boolean_mask}
        task_type: 'Regression' or 'Classification'
        target_disparity: Target disparity value (None = minimize as much as possible)
    
    Returns:
        np.array: Calibrated predictions
        float: Final disparity after calibration
    """
    y_pred_calibrated = y_pred.copy()
    
    if task_type == 'Regression':
        # Calculate RMSE per group
        group_rmse = {}
        for group_name, group_mask in demographic_groups.items():
            if np.sum(group_mask) > 0:
                group_rmse[group_name] = np.sqrt(mean_squared_error(
                    y_test[group_mask], y_pred[group_mask]
                ))
        
        if len(group_rmse) >= 2:
            rmse_values = list(group_rmse.values())
            initial_disparity = abs(rmse_values[0] - rmse_values[1])
            
            # Calibrate: scale predictions for group with higher RMSE
            if initial_disparity > 0:
                max_rmse_group = max(group_rmse.items(), key=lambda x: x[1])[0]
                min_rmse_group = min(group_rmse.items(), key=lambda x: x[1])[0]
                
                max_rmse = group_rmse[max_rmse_group]
                min_rmse = group_rmse[min_rmse_group]
                
                # Scale factor to equalize RMSE
                scale_factor = min_rmse / max_rmse if max_rmse > 0 else 1.0
                
                # Apply scaling to the group with higher RMSE
                max_group_mask = demographic_groups[max_rmse_group]
                y_pred_calibrated[max_group_mask] = y_pred[max_group_mask] * scale_factor
                
                # Recalculate disparity
                new_rmse_max = np.sqrt(mean_squared_error(
                    y_test[max_group_mask], y_pred_calibrated[max_group_mask]
                ))
                final_disparity = abs(new_rmse_max - min_rmse)
            else:
                final_disparity = 0.0
        else:
            final_disparity = 0.0
    
    else:  # Classification
        # Calculate accuracy per group
        group_acc = {}
        for group_name, group_mask in demographic_groups.items():
            if np.sum(group_mask) > 0:
                group_acc[group_name] = accuracy_score(
                    y_test[group_mask], y_pred[group_mask]
                )
        
        if len(group_acc) >= 2:
            acc_values = list(group_acc.values())
            initial_disparity = abs(acc_values[0] - acc_values[1])
            
            # For classification, use probability threshold adjustment
            # This is a simplified approach - in practice, you'd adjust decision thresholds
            # For now, we'll use a simple scaling approach on predicted probabilities
            # (This assumes y_pred are probabilities, not classes)
            
            # If predictions are classes, convert to probabilities (simplified)
            if y_pred.dtype in [np.int64, np.int32, np.int8]:
                # Can't easily calibrate class predictions
                final_disparity = initial_disparity
            else:
                # Adjust probability thresholds per group
                max_acc_group = max(group_acc.items(), key=lambda x: x[1])[0]
                min_acc_group = min(group_acc.items(), key=lambda x: x[1])[0]
                
                # Simple threshold adjustment
                threshold_adjustment = (group_acc[max_acc_group] - group_acc[min_acc_group]) / 2
                
                max_group_mask = demographic_groups[max_acc_group]
                min_group_mask = demographic_groups[min_acc_group]
                
                # Adjust predictions (simplified - would need actual probabilities)
                y_pred_calibrated[max_group_mask] = np.clip(
                    y_pred[max_group_mask] - threshold_adjustment, 0, 1
                )
                y_pred_calibrated[min_group_mask] = np.clip(
                    y_pred[min_group_mask] + threshold_adjustment, 0, 1
                )
                
                # Recalculate disparity
                new_acc_max = accuracy_score(
                    y_test[max_group_mask], 
                    (y_pred_calibrated[max_group_mask] > 0.5).astype(int)
                )
                new_acc_min = accuracy_score(
                    y_test[min_group_mask],
                    (y_pred_calibrated[min_group_mask] > 0.5).astype(int)
                )
                final_disparity = abs(new_acc_max - new_acc_min)
        else:
            final_disparity = 0.0
    
    return y_pred_calibrated, final_disparity


def calculate_sample_weights(y_train, demographic_train, balance_groups=True):
    """
    Calculate sample weights to balance demographic groups.
    
    General technique: Weight samples inversely proportional to group frequency.
    Works for any demographic grouping.
    
    Args:
        y_train: Training targets
        demographic_train: Demographic group labels for training set
        balance_groups: If True, balance groups; if False, return uniform weights
    
    Returns:
        np.array: Sample weights
    """
    if not balance_groups:
        return np.ones(len(y_train))
    
    # Get unique groups
    if isinstance(demographic_train, dict):
        # If it's a dict of masks, convert to labels
        group_labels = np.zeros(len(y_train), dtype=int)
        for idx, (group_name, mask) in enumerate(demographic_train.items()):
            if isinstance(mask, np.ndarray) and len(mask) == len(y_train):
                group_labels[mask] = idx
        unique_groups = np.unique(group_labels)
    else:
        unique_groups = np.unique(demographic_train)
        group_labels = demographic_train
    
    # Calculate group frequencies
    group_counts = {}
    for group in unique_groups:
        group_counts[group] = np.sum(group_labels == group)
    
    # Calculate weights (inverse frequency)
    total_samples = len(y_train)
    n_groups = len(unique_groups)
    
    weights = np.ones(len(y_train))
    for group in unique_groups:
        group_mask = group_labels == group
        if group_counts[group] > 0:
            # Weight = total_samples / (n_groups * group_count)
            weights[group_mask] = total_samples / (n_groups * group_counts[group])
    
    # Normalize weights
    weights = weights / np.mean(weights)
    
    return weights


def improve_fairness_automatically(models_dict, predictions_dict, X_train, X_test, 
                                   y_train, y_test, demographic_train, demographic_test,
                                   shap_results_dict, feature_names, task_type,
                                   fairness_df, disparity_threshold=None,
                                   enable_post_processing=True, enable_feature_downweighting=True,
                                   prefer_fair_model=True):
    """
    AUTOMATIC FAIRNESS IMPROVEMENT - General solution for all datasets.
    
    This function automatically:
    1. Detects high disparity
    2. Identifies high-disparity features from SHAP
    3. Selects fairest model (RandomForest if disparity is high)
    4. Applies post-processing calibration if needed
    5. Returns improved predictions and models
    
    Args:
        models_dict: Dict of {model_name: trained_model}
        predictions_dict: Dict of {model_name: predictions}
        X_train, X_test: Training and test features
        y_train, y_test: Training and test targets
        demographic_train, demographic_test: Demographic groups (dict of masks or array)
        shap_results_dict: Dict of {model_name: {importance_dict, ...}}
        feature_names: List of feature names
        task_type: 'Regression' or 'Classification'
        fairness_df: DataFrame with fairness metrics
        disparity_threshold: Threshold for high disparity (None = auto-detect)
        enable_post_processing: Apply post-processing calibration (default: True)
        enable_feature_downweighting: Downweight high-disparity features (default: True)
        prefer_fair_model: Prefer RandomForest when disparity is high (default: True)
    
    Returns:
        dict: {
            'improved_predictions': {model_name: calibrated_predictions},
            'improved_models': {model_name: model},
            'high_disparity_features': list,
            'best_fair_model': str,
            'disparity_before': float,
            'disparity_after': float,
            'improvement_percent': float
        }
    """
    print(f"\n  🔧 Applying Automatic Fairness Improvement...")
    
    # Convert demographic_test to dict format if needed
    if not isinstance(demographic_test, dict):
        unique_groups = np.unique(demographic_test)
        demographic_test = {group: demographic_test == group for group in unique_groups[:2]}
    
    # Calculate current disparity
    if fairness_df is not None and 'Disparity' in fairness_df.columns:
        current_disparity = fairness_df['Disparity'].max()
        best_model_name = fairness_df.loc[fairness_df['Disparity'].idxmin(), 'Model']
    else:
        # Calculate disparity manually
        disparities = {}
        for model_name, y_pred in predictions_dict.items():
            if task_type == 'Regression':
                group_rmse = []
                for group_mask in demographic_test.values():
                    if np.sum(group_mask) > 0:
                        group_rmse.append(np.sqrt(mean_squared_error(
                            y_test[group_mask], y_pred[group_mask]
                        )))
                if len(group_rmse) >= 2:
                    disparities[model_name] = abs(group_rmse[0] - group_rmse[1])
        if disparities:
            current_disparity = max(disparities.values())
            best_model_name = min(disparities.items(), key=lambda x: x[1])[0]
        else:
            current_disparity = 0.0
            best_model_name = list(models_dict.keys())[0]
    
    # Auto-detect threshold if not provided
    if disparity_threshold is None:
        if task_type == 'Regression':
            # For regression: threshold based on scale of target
            target_scale = np.std(y_test) if len(y_test) > 0 else 1.0
            disparity_threshold = target_scale * 0.1  # 10% of target std
        else:
            # For classification: threshold is absolute difference in accuracy
            disparity_threshold = 0.05  # 5% accuracy difference
    
    print(f"    📊 Current Disparity: {current_disparity:.4f}")
    print(f"    📊 Threshold: {disparity_threshold:.4f}")
    
    # Check if improvement is needed
    if current_disparity <= disparity_threshold:
        print(f"    ✅ Disparity already below threshold, no improvement needed")
        return {
            'improved_predictions': predictions_dict,
            'improved_models': models_dict,
            'high_disparity_features': [],
            'best_fair_model': best_model_name,
            'disparity_before': current_disparity,
            'disparity_after': current_disparity,
            'improvement_percent': 0.0
        }
    
    # Step 1: Identify high-disparity features from SHAP
    high_disparity_features = []
    if enable_feature_downweighting and shap_results_dict:
        shap_importance_dict = {}
        for model_name, shap_data in shap_results_dict.items():
            if isinstance(shap_data, dict) and 'importance' in shap_data:
                shap_importance_dict[model_name] = shap_data['importance']
        
        high_disparity_features = detect_high_disparity_features(
            shap_importance_dict, feature_names, demographic_test,
            X_test, y_test, predictions_dict, task_type
        )
        
        if high_disparity_features:
            print(f"    ⚠️  Detected {len(high_disparity_features)} high-disparity features:")
            print(f"       {', '.join(high_disparity_features[:5])}{'...' if len(high_disparity_features) > 5 else ''}")
    
    # Step 2: Select fairest model (prefer RandomForest if disparity is high)
    if prefer_fair_model and current_disparity > disparity_threshold:
        # Check if RandomForest exists and has better fairness
        if 'RandomForest' in models_dict:
            rf_disparity = fairness_df[fairness_df['Model'] == 'RandomForest']['Disparity'].values
            if len(rf_disparity) > 0 and rf_disparity[0] < current_disparity * 0.8:
                best_model_name = 'RandomForest'
                print(f"    ✅ Selected RandomForest (better fairness)")
    
    # Step 3: Apply post-processing calibration
    improved_predictions = predictions_dict.copy()
    final_disparity = current_disparity
    
    if enable_post_processing and current_disparity > disparity_threshold:
        print(f"    🔧 Applying post-processing calibration...")
        
        # Calibrate predictions for best model
        if best_model_name in improved_predictions:
            y_pred_original = improved_predictions[best_model_name]
            y_pred_calibrated, cal_disparity = apply_post_processing_calibration(
                y_pred_original, y_test, demographic_test, task_type
            )
            improved_predictions[best_model_name] = y_pred_calibrated
            final_disparity = cal_disparity
            
            improvement_percent = ((current_disparity - final_disparity) / current_disparity * 100) if current_disparity > 0 else 0.0
            print(f"    ✅ Post-processing complete:")
            print(f"       Disparity: {current_disparity:.4f} → {final_disparity:.4f}")
            print(f"       Improvement: {improvement_percent:.1f}%")
    
    return {
        'improved_predictions': improved_predictions,
        'improved_models': models_dict,
        'high_disparity_features': high_disparity_features,
        'best_fair_model': best_model_name,
        'disparity_before': current_disparity,
        'disparity_after': final_disparity,
        'improvement_percent': improvement_percent if 'improvement_percent' in locals() else 0.0
    }


def integrate_fairness_improvement_into_pipeline(fairness_results, models_dict, predictions_dict,
                                                 X_train, X_test, y_train, y_test,
                                                 demographic_train, demographic_test,
                                                 shap_results_dict, feature_names, task_type,
                                                 auto_improve=True, disparity_threshold=None):
    """
    Integration function for comprehensive_ml_pipeline.py
    
    This function can be called after fairness analysis to automatically improve fairness.
    
    Args:
        fairness_results: DataFrame from perform_fairness_analysis()
        models_dict: Dict of trained models
        predictions_dict: Dict of predictions
        X_train, X_test, y_train, y_test: Data splits
        demographic_train, demographic_test: Demographic groups
        shap_results_dict: SHAP results
        feature_names: Feature names
        task_type: Task type
        auto_improve: Automatically improve if disparity is high (default: True)
        disparity_threshold: Threshold for improvement (None = auto-detect)
    
    Returns:
        dict: Improved results with calibrated predictions
    """
    if not auto_improve:
        return {
            'improved_predictions': predictions_dict,
            'improved_models': models_dict,
            'improvement_applied': False
        }
    
    improvement_results = improve_fairness_automatically(
        models_dict, predictions_dict, X_train, X_test,
        y_train, y_test, demographic_train, demographic_test,
        shap_results_dict, feature_names, task_type,
        fairness_results, disparity_threshold=disparity_threshold
    )
    
    return {
        'improved_predictions': improvement_results['improved_predictions'],
        'improved_models': improvement_results['improved_models'],
        'high_disparity_features': improvement_results['high_disparity_features'],
        'best_fair_model': improvement_results['best_fair_model'],
        'disparity_before': improvement_results['disparity_before'],
        'disparity_after': improvement_results['disparity_after'],
        'improvement_percent': improvement_results['improvement_percent'],
        'improvement_applied': improvement_results['improvement_percent'] > 0
    }

